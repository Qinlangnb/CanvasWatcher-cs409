# Copy to .env for `docker compose`. Never commit .env.
# Local database password (the database only listens on 127.0.0.1).
POSTGRES_PASSWORD=canvaswatcher
# Host port for PostgreSQL. Change it if 5432 is taken or reserved (Windows can reserve port ranges),
# and use the same port in server/.env.
# POSTGRES_PORT=5432
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=
# Encrypts stored Canvas tokens: 32 random bytes in base64, generated the same way as SESSION_SECRET.
# Keep it stable; if it changes, users have to reconnect Canvas.
CREDENTIALS_KEY=
# Browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8080
# Serve the app under a path instead of the site root, e.g. /cs409 when another reverse proxy forwards
# https://example.com/cs409/... to this stack unchanged. The frontend is built for that path and the
# sign-in cookies are scoped to it, so another app on the same site cannot overwrite them.
# Run `docker compose up -d --build` after changing it.
# PUBLIC_BASE_PATH=/cs409

# Username of an existing account whose data the sign-in page's "Preview" button copies (identity taken out).
# Leave empty for no preview.
PREVIEW_SOURCE_USERNAME=
