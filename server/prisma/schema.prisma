// Database schema for the CanvasWatcher API.
// Tables and columns are snake_case in PostgreSQL; Prisma fields are camelCase.
// Every table that holds a user's data references users(id) and is always queried with that user's id.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  /// Display form, as the user typed it.
  username          String
  /// Lower-cased username; makes sign-in and uniqueness case-insensitive.
  usernameKey       String             @unique @map("username_key")
  /// Stored lower-cased.
  email             String             @unique
  passwordHash      String             @map("password_hash")
  /// Set on preview accounts, which are deleted at this time. Previews have no usable password.
  /// The column keeps its first name, from when previews were sample-data demos.
  previewExpiresAt  DateTime?          @map("demo_expires_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions          Session[]
  canvas            CanvasConnection?
  syncRuns          SyncRun[]
  courses           Course[]
  tasks             Task[]
  files             CourseFile[]
  sourceItems       SourceItem[]
  changes           ChangeEvent[]
  settings          UserSettings?
  calendars         CalendarSource[]
  events            CalendarEvent[]
  syllabi           CourseSyllabus[]
  sources           SourceConnection[]
  canvasCredentials CanvasCredential[]
  providerSessions  ProviderSession[]
  authChallenges    AuthChallenge[]
  oauthStates       CanvasOAuthState[]

  @@index([previewExpiresAt])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Fixed-window counters for sign-in and registration throttling.
model LoginAttempt {
  /// SHA-256 of the throttle key (for example client address plus username).
  keyHash     String   @id @map("key_hash")
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@map("login_attempts")
}

enum ConnectionStatus {
  /// The last request with this token succeeded.
  OK
  /// Canvas answered 401: the token was revoked or has expired.
  TOKEN_REJECTED

  @@map("connection_status")
}

/// One Canvas account per user: the account binding. Every credential slot (canvas_credentials) must
/// sign in to this base URL and Canvas user id; a credential for another account is rejected.
model CanvasConnection {
  userId          String            @id @map("user_id") @db.Uuid
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Origin only, for example https://canvas.illinois.edu.
  baseUrl         String            @map("base_url")
  /// Before credential slots: the personal access token sealed with AAD = user_id. It was copied to
  /// canvas_credentials and is cleared here once the PAT slot is first used or changed.
  tokenCiphertext String?           @map("token_ciphertext")
  canvasUserId    String            @map("canvas_user_id")
  displayName     String            @map("display_name")
  /// TOKEN_REJECTED once no credential slot works any more.
  status          ConnectionStatus  @default(OK)
  verifiedAt      DateTime          @map("verified_at") @db.Timestamptz(3)
  /// The method the user prefers (PAT or browser session); null keeps the default order.
  preferredMethod CanvasAuthMethod? @map("preferred_method")
  /// The last automatic switch to a backup slot: { from, to, reason_code, at }.
  fallback        Json?
  /// A sync holds this lease while it runs, so one user never has two syncs at once.
  syncLeaseUntil  DateTime?         @map("sync_lease_until") @db.Timestamptz(3)
  lastSyncedAt    DateTime?         @map("last_synced_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lastSyncedAt])
  @@map("canvas_connections")
}

enum SyncTrigger {
  CONNECT
  MANUAL
  SCHEDULED

  @@map("sync_trigger")
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  /// Finished, but some courses or resources could not be read.
  PARTIAL
  FAILED

  @@map("sync_status")
}

model SyncRun {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger         SyncTrigger
  status          SyncStatus  @default(RUNNING)
  startedAt       DateTime    @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?   @map("finished_at") @db.Timestamptz(3)
  coursesSynced   Int         @default(0) @map("courses_synced")
  changesDetected Int         @default(0) @map("changes_detected")
  /// Short, user-facing explanation when the status is PARTIAL or FAILED.
  error           String?

  @@index([userId, startedAt])
  @@map("sync_runs")
}

model Course {
  id          Int                @id @default(autoincrement())
  userId      String             @map("user_id") @db.Uuid
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasId    String             @map("canvas_id")
  courseCode  String             @map("course_code")
  name        String
  termName    String?            @map("term_name")
  termStartAt DateTime?          @map("term_start_at") @db.Timestamptz(3)
  termEndAt   DateTime?          @map("term_end_at") @db.Timestamptz(3)
  htmlUrl     String             @map("html_url")
  /// Set when the user hides the course; sync keeps updating it.
  archivedAt  DateTime?          @map("archived_at") @db.Timestamptz(3)
  /// The last sync that saw this course among the user's active enrollments.
  lastSeenAt  DateTime           @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tasks       Task[]
  files       CourseFile[]
  sourceItems SourceItem[]
  changes     ChangeEvent[]
  syllabus    CourseSyllabus?
  sources     SourceConnection[]

  @@unique([userId, canvasId])
  @@index([userId, archivedAt])
  @@map("courses")
}

enum TaskSource {
  /// Synced from a Canvas assignment; sync owns the title, due date and points.
  CANVAS
  /// Added by the student; sync never touches it.
  PERSONAL

  @@map("task_source")
}

/// A Canvas assignment or a task the student added, plus the student's own progress on it.
model Task {
  id               Int        @id @default(autoincrement())
  userId           String     @map("user_id") @db.Uuid
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         Int        @map("course_id")
  course           Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source           TaskSource @default(CANVAS)
  /// Null for personal tasks.
  canvasId         String?    @map("canvas_id")
  title            String
  /// assignment, homework, exam, project or reading, guessed from the title and group.
  taskType         String     @map("task_type")
  dueAt            DateTime?  @map("due_at") @db.Timestamptz(3)
  pointsPossible   Float?     @map("points_possible")
  htmlUrl          String?    @map("html_url")
  /// Canvas workflow_state of the submission: unsubmitted, submitted, graded or pending_review.
  submissionState  String?    @map("submission_state")
  submittedAt      DateTime?  @map("submitted_at") @db.Timestamptz(3)
  completedAt      DateTime?  @map("completed_at") @db.Timestamptz(3)
  ignoredAt        DateTime?  @map("ignored_at") @db.Timestamptz(3)
  /// Set when the assignment disappears from Canvas.
  removedAt        DateTime?  @map("removed_at") @db.Timestamptz(3)
  /// Percent done, 0-100, as the student reports it.
  progress         Int        @default(0)
  /// The student's estimate of the total work; null means "use the default for the task type".
  estimatedMinutes Int?       @map("estimated_minutes")
  /// Minutes the student says they have spent on it so far. With progress, it gives a better
  /// estimate of what is left than the type's default.
  spentMinutes     Int        @default(0) @map("spent_minutes")
  /// The student's Canvas score and grade once Canvas shows them; null until graded or while hidden.
  score            Float?
  grade            String?
  excused          Boolean    @default(false)
  /// Local date (YYYY-MM-DD) the student started this task before the plan reached it. That day's plan
  /// includes it; on later days the planner decides on its own again.
  startedOn        String?    @map("started_on") @db.VarChar(10)
  notes            String?
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([courseId, canvasId])
  @@index([userId, dueAt])
  @@map("tasks")
}

/// Metadata of a Canvas course file. Contents are fetched from Canvas when downloaded.
model CourseFile {
  id              Int       @id @default(autoincrement())
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        Int       @map("course_id")
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  canvasId        String    @map("canvas_id")
  displayName     String    @map("display_name")
  contentType     String?   @map("content_type")
  sizeBytes       Int       @map("size_bytes")
  canvasUpdatedAt DateTime? @map("canvas_updated_at") @db.Timestamptz(3)
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([courseId, canvasId])
  @@index([userId, courseId])
  @@map("files")
}

enum ItemKind {
  ASSIGNMENT
  FILE
  ANNOUNCEMENT

  @@map("item_kind")
}

/// The last-seen version of every tracked Canvas item, used to detect changes.
model SourceItem {
  id          Int           @id @default(autoincrement())
  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    Int           @map("course_id")
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind        ItemKind
  canvasId    String        @map("canvas_id")
  title       String
  htmlUrl     String?       @map("html_url")
  /// SHA-256 of `content`; unchanged items are skipped without comparing fields.
  contentHash String        @map("content_hash")
  /// The fields compared between syncs, for example title, due date and description.
  content     Json
  firstSeenAt DateTime      @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  removedAt   DateTime?     @map("removed_at") @db.Timestamptz(3)
  changes     ChangeEvent[]

  @@unique([courseId, kind, canvasId])
  @@map("source_items")
}

enum ChangeType {
  CREATED
  UPDATED
  REMOVED

  @@map("change_type")
}

model ChangeEvent {
  id           Int        @id @default(autoincrement())
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     Int        @map("course_id")
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceItemId Int        @map("source_item_id")
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  changeType   ChangeType @map("change_type")
  /// Names of the content fields that differ, for example ["due_at"].
  fields       String[]
  summary      String
  before       Json?
  after        Json?
  detectedAt   DateTime   @default(now()) @map("detected_at") @db.Timestamptz(3)
  readAt       DateTime?  @map("read_at") @db.Timestamptz(3)

  /// The feed is newest first by id (ids grow with detection time), paged with an id cursor.
  @@index([userId, id])
  @@index([userId, readAt])
  @@index([courseId, id])
  @@map("change_events")
}

/// Planning preferences. A user without a row gets the defaults.
model UserSettings {
  userId            String   @id @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// IANA name, for example America/Chicago. Decides what "today" means.
  timeZone          String   @default("America/Chicago") @map("time_zone")
  /// How much study time Today plans for each day.
  dailyStudyMinutes Int      @default(180) @map("daily_study_minutes")
  /// Study window, in minutes after local midnight; the end is exclusive and may be 1440.
  studyStartMinute  Int      @default(540) @map("study_start_minute")
  studyEndMinute    Int      @default(1320) @map("study_end_minute")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_settings")
}

/// An imported .ics file. Its events are replaced as a whole, never edited one by one.
model CalendarSource {
  id         Int             @id @default(autoincrement())
  userId     String          @map("user_id") @db.Uuid
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  fileName   String?         @map("file_name")
  importedAt DateTime        @default(now()) @map("imported_at") @db.Timestamptz(3)
  events     CalendarEvent[]

  @@index([userId])
  @@map("calendar_sources")
}

/// One occurrence on the calendar. Recurring imported events are stored expanded.
model CalendarEvent {
  id        Int             @id @default(autoincrement())
  userId    String          @map("user_id") @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null for events the user added by hand.
  sourceId  Int?            @map("source_id")
  source    CalendarSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title     String
  location  String?
  /// All-day events store UTC midnight of their first day and of the day after their last.
  startAt   DateTime        @map("start_at") @db.Timestamptz(3)
  endAt     DateTime        @map("end_at") @db.Timestamptz(3)
  allDay    Boolean         @default(false) @map("all_day")
  /// Busy time is subtracted from the study window when Today plans.
  busy      Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, startAt])
  @@index([sourceId])
  @@map("calendar_events")
}

/// The last syllabus found for a course (see canvas/syllabus.ts), kept so it can be shown and
/// given to AI Chat when Canvas can't be asked: previews, a rejected token, Canvas being down.
model CourseSyllabus {
  courseId  Int      @id @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The Syllabus as the API returns it: { found, sources }.
  content   Json
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("course_syllabi")
}

enum SourceType {
  CANVAS
  /// A course website (public or NTLM-protected).
  WEBSITE
  GRADESCOPE
  PRAIRIELEARN

  @@map("source_type")
}

enum SourceHealth {
  /// Never synced.
  UNKNOWN
  HEALTHY
  /// Some resources could not be read; the rest is up to date.
  DEGRADED
  AUTH_REQUIRED
  ERROR

  @@map("source_health")
}

/// Where a user's academic data comes from: their Canvas account, a course website, Gradescope or
/// PrairieLearn. One row per (user, type, base URL); only one Canvas row per user.
model SourceConnection {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            SourceType
  name            String
  /// Normalized http(s) URL without query or fragment; an origin for Canvas.
  baseUrl         String           @map("base_url")
  /// The course this source belongs to (course websites); null for account-level sources.
  courseId        Int?             @map("course_id")
  course          Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  /// Type-specific, secret-free settings (for example a website's authentication method).
  config          Json             @default("{}")
  /// READY, AUTH_REQUIRED, DISABLED, ERROR or PENDING; plain text so new source types can add states.
  state           String           @default("READY")
  /// Disabled sources are skipped by sync and keep their data.
  enabled         Boolean          @default(true)
  lastSyncAt      DateTime?        @map("last_sync_at") @db.Timestamptz(3)
  lastSuccessAt   DateTime?        @map("last_success_at") @db.Timestamptz(3)
  lastError       String?          @map("last_error")
  health          SourceHealth     @default(UNKNOWN)
  healthSummary   String?          @map("health_summary")
  /// Resources the last sync could not read: [{ resource, course, code, http_status, optional }].
  diagnostics     Json             @default("[]")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  providerSession ProviderSession?

  @@unique([userId, type, baseUrl])
  @@index([userId])
  @@map("source_connections")
}

enum CanvasAuthMethod {
  PAT
  BROWSER_SESSION
  OAUTH

  @@map("canvas_auth_method")
}

enum CredentialState {
  MISSING
  VALID
  INVALID
  EXPIRED
  REVOKED

  @@map("credential_state")
}

/// One Canvas credential slot per user and method. A removed slot keeps its row (state and failure
/// reason) with the secret cleared; every install and removal bumps the generation, so a background
/// check that started before a replacement can never clear the replacement.
model CanvasCredential {
  userId             String           @map("user_id") @db.Uuid
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  method             CanvasAuthMethod
  /// Sealed with AAD "<user_id>:canvas:<method>": a PAT, a JSON cookie jar or JSON OAuth tokens.
  secretCiphertext   String?          @map("secret_ciphertext")
  /// Set on PATs copied from canvas_connections, which were sealed with AAD = user_id; re-sealed on first use.
  legacyAad          Boolean          @default(false) @map("legacy_aad")
  generation         Int              @default(0)
  state              CredentialState  @default(MISSING)
  verifiedAt         DateTime?        @map("verified_at") @db.Timestamptz(3)
  lastSuccessAt      DateTime?        @map("last_success_at") @db.Timestamptz(3)
  failedAt           DateTime?        @map("failed_at") @db.Timestamptz(3)
  failureReason      String?          @map("failure_reason")
  /// SHA-256 of "<base_url>|<canvas user id>" for the account this secret signed in as.
  accountFingerprint String?          @map("account_fingerprint")
  /// PAT expiry (user-entered, end of that day in their time zone) or OAuth access-token expiry.
  expiresAt          DateTime?        @map("expires_at") @db.Timestamptz(3)
  /// USER_ENTERED, CANVAS_API or UNKNOWN.
  expirationSource   String?          @map("expiration_source")
  /// The PAT expiry state last announced (warning, urgent, critical, expired), so each is sent once.
  notifiedState      String?          @map("notified_state")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([userId, method])
  @@map("canvas_credentials")
}

/// The signed-in cookie jar of a Gradescope or PrairieLearn connection, captured by the Auth Broker.
model ProviderSession {
  connectionId     String           @id @map("connection_id") @db.Uuid
  connection       SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId           String           @map("user_id") @db.Uuid
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// JSON { name: value } sealed with AAD "<user_id>:provider-session:<connection_id>".
  cookieCiphertext String?          @map("cookie_ciphertext")
  generation       Int              @default(0)
  state            CredentialState  @default(MISSING)
  verifiedAt       DateTime?        @map("verified_at") @db.Timestamptz(3)
  failedAt         DateTime?        @map("failed_at") @db.Timestamptz(3)
  failureReason    String?          @map("failure_reason")
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("provider_sessions")
}

enum ChallengeState {
  WAITING_FOR_USER
  LOGIN_OPENED
  AUTHENTICATED
  FAILED
  CANCELLED
  TIMED_OUT

  @@map("challenge_state")
}

/// A browser sign-in handed to the desktop Auth Broker. Only SHA-256 hashes of its three capabilities
/// are stored: the ticket the page gives the broker, the page's control token and the broker's
/// exchange token. The broker has no session; its requests reach the user only through this row.
model AuthChallenge {
  /// Random and URL-safe; the protocol's challenge_id.
  id           String         @id
  userId       String         @map("user_id") @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// canvas, gradescope, prairielearn or all.
  provider     String
  /// login, clear or clear_all.
  operation    String
  /// What the broker signs in to: { base_url, credential_id, operation, generation(s) }.
  target       Json
  ticketHash   String         @map("ticket_hash")
  controlHash  String         @map("control_hash")
  exchangeHash String?        @map("exchange_hash")
  state        ChallengeState @default(WAITING_FOR_USER)
  claimed      Boolean        @default(false)
  /// Set when the broker starts completing, so an exchange token works once.
  finishing    Boolean        @default(false)
  reason       String?
  deadline     DateTime       @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([deadline])
  @@map("auth_challenges")
}

/// A pending Canvas OAuth authorization: single use, short-lived, bound to the user and slot generation.
model CanvasOAuthState {
  /// SHA-256 of the state parameter; the parameter itself is never stored.
  stateHash   String   @id @map("state_hash")
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation  Int
  baseUrl     String   @map("base_url")
  redirectUri String   @map("redirect_uri")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("canvas_oauth_states")
}
