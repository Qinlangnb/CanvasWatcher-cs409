// Database schema for the CanvasWatcher API.
// Tables and columns are snake_case in PostgreSQL; Prisma fields are camelCase.
// Every table that holds a user's data references users(id) and is always queried with that user's id.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// Display form, as the user typed it.
  username     String
  /// Lower-cased username; makes sign-in and uniqueness case-insensitive.
  usernameKey  String    @unique @map("username_key")
  /// Stored lower-cased.
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Fixed-window counters for sign-in and registration throttling.
model LoginAttempt {
  /// SHA-256 of the throttle key (for example client address plus username).
  keyHash     String   @id @map("key_hash")
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@map("login_attempts")
}
