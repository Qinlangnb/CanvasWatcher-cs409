// Database schema for the CanvasWatcher API.
// Tables and columns are snake_case in PostgreSQL; Prisma fields are camelCase.
// Every table that holds a user's data references users(id) and is always queried with that user's id.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(uuid()) @db.Uuid
  /// Display form, as the user typed it.
  username      String
  /// Lower-cased username; makes sign-in and uniqueness case-insensitive.
  usernameKey   String            @unique @map("username_key")
  /// Stored lower-cased.
  email         String            @unique
  passwordHash  String            @map("password_hash")
  /// Set on demo accounts, which are deleted at this time. Demo accounts have no usable password.
  demoExpiresAt DateTime?         @map("demo_expires_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  canvas        CanvasConnection?
  syncRuns      SyncRun[]
  courses       Course[]
  tasks         Task[]
  files         CourseFile[]
  sourceItems   SourceItem[]
  changes       ChangeEvent[]
  settings      UserSettings?
  calendars     CalendarSource[]
  events        CalendarEvent[]

  @@index([demoExpiresAt])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Fixed-window counters for sign-in and registration throttling.
model LoginAttempt {
  /// SHA-256 of the throttle key (for example client address plus username).
  keyHash     String   @id @map("key_hash")
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@map("login_attempts")
}

enum ConnectionStatus {
  /// The last request with this token succeeded.
  OK
  /// Canvas answered 401: the token was revoked or has expired.
  TOKEN_REJECTED

  @@map("connection_status")
}

/// One Canvas account per user.
model CanvasConnection {
  userId          String           @id @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Origin only, for example https://canvas.illinois.edu.
  baseUrl         String           @map("base_url")
  /// Personal access token sealed with CREDENTIALS_KEY (AES-256-GCM, bound to user_id).
  tokenCiphertext String           @map("token_ciphertext")
  canvasUserId    String           @map("canvas_user_id")
  displayName     String           @map("display_name")
  status          ConnectionStatus @default(OK)
  verifiedAt      DateTime         @map("verified_at") @db.Timestamptz(3)
  /// A sync holds this lease while it runs, so one user never has two syncs at once.
  syncLeaseUntil  DateTime?        @map("sync_lease_until") @db.Timestamptz(3)
  lastSyncedAt    DateTime?        @map("last_synced_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lastSyncedAt])
  @@map("canvas_connections")
}

enum SyncTrigger {
  CONNECT
  MANUAL
  SCHEDULED

  @@map("sync_trigger")
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  /// Finished, but some courses or resources could not be read.
  PARTIAL
  FAILED

  @@map("sync_status")
}

model SyncRun {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger         SyncTrigger
  status          SyncStatus  @default(RUNNING)
  startedAt       DateTime    @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?   @map("finished_at") @db.Timestamptz(3)
  coursesSynced   Int         @default(0) @map("courses_synced")
  changesDetected Int         @default(0) @map("changes_detected")
  /// Short, user-facing explanation when the status is PARTIAL or FAILED.
  error           String?

  @@index([userId, startedAt])
  @@map("sync_runs")
}

model Course {
  id          Int           @id @default(autoincrement())
  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasId    String        @map("canvas_id")
  courseCode  String        @map("course_code")
  name        String
  termName    String?       @map("term_name")
  termStartAt DateTime?     @map("term_start_at") @db.Timestamptz(3)
  termEndAt   DateTime?     @map("term_end_at") @db.Timestamptz(3)
  htmlUrl     String        @map("html_url")
  /// Set when the user hides the course; sync keeps updating it.
  archivedAt  DateTime?     @map("archived_at") @db.Timestamptz(3)
  /// The last sync that saw this course among the user's active enrollments.
  lastSeenAt  DateTime      @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tasks       Task[]
  files       CourseFile[]
  sourceItems SourceItem[]
  changes     ChangeEvent[]

  @@unique([userId, canvasId])
  @@index([userId, archivedAt])
  @@map("courses")
}

enum TaskSource {
  /// Synced from a Canvas assignment; sync owns the title, due date and points.
  CANVAS
  /// Added by the student; sync never touches it.
  PERSONAL

  @@map("task_source")
}

/// A Canvas assignment or a task the student added, plus the student's own progress on it.
model Task {
  id               Int        @id @default(autoincrement())
  userId           String     @map("user_id") @db.Uuid
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         Int        @map("course_id")
  course           Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source           TaskSource @default(CANVAS)
  /// Null for personal tasks.
  canvasId         String?    @map("canvas_id")
  title            String
  /// assignment, homework, exam, project or reading, guessed from the title and group.
  taskType         String     @map("task_type")
  dueAt            DateTime?  @map("due_at") @db.Timestamptz(3)
  pointsPossible   Float?     @map("points_possible")
  htmlUrl          String?    @map("html_url")
  /// Canvas workflow_state of the submission: unsubmitted, submitted, graded or pending_review.
  submissionState  String?    @map("submission_state")
  submittedAt      DateTime?  @map("submitted_at") @db.Timestamptz(3)
  completedAt      DateTime?  @map("completed_at") @db.Timestamptz(3)
  ignoredAt        DateTime?  @map("ignored_at") @db.Timestamptz(3)
  /// Set when the assignment disappears from Canvas.
  removedAt        DateTime?  @map("removed_at") @db.Timestamptz(3)
  /// Percent done, 0-100, as the student reports it.
  progress         Int        @default(0)
  /// The student's estimate of the total work; null means "use the default for the task type".
  estimatedMinutes Int?       @map("estimated_minutes")
  /// Local date (YYYY-MM-DD) the student started this task before the plan reached it. That day's plan
  /// includes it; on later days the planner decides on its own again.
  startedOn        String?    @map("started_on") @db.VarChar(10)
  notes            String?
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([courseId, canvasId])
  @@index([userId, dueAt])
  @@map("tasks")
}

/// Metadata of a Canvas course file. Contents are fetched from Canvas when downloaded.
model CourseFile {
  id              Int       @id @default(autoincrement())
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        Int       @map("course_id")
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  canvasId        String    @map("canvas_id")
  displayName     String    @map("display_name")
  contentType     String?   @map("content_type")
  sizeBytes       Int       @map("size_bytes")
  canvasUpdatedAt DateTime? @map("canvas_updated_at") @db.Timestamptz(3)
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([courseId, canvasId])
  @@index([userId, courseId])
  @@map("files")
}

enum ItemKind {
  ASSIGNMENT
  FILE
  ANNOUNCEMENT

  @@map("item_kind")
}

/// The last-seen version of every tracked Canvas item, used to detect changes.
model SourceItem {
  id          Int           @id @default(autoincrement())
  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    Int           @map("course_id")
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind        ItemKind
  canvasId    String        @map("canvas_id")
  title       String
  htmlUrl     String?       @map("html_url")
  /// SHA-256 of `content`; unchanged items are skipped without comparing fields.
  contentHash String        @map("content_hash")
  /// The fields compared between syncs, for example title, due date and description.
  content     Json
  firstSeenAt DateTime      @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  removedAt   DateTime?     @map("removed_at") @db.Timestamptz(3)
  changes     ChangeEvent[]

  @@unique([courseId, kind, canvasId])
  @@map("source_items")
}

enum ChangeType {
  CREATED
  UPDATED
  REMOVED

  @@map("change_type")
}

model ChangeEvent {
  id           Int        @id @default(autoincrement())
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     Int        @map("course_id")
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceItemId Int        @map("source_item_id")
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  changeType   ChangeType @map("change_type")
  /// Names of the content fields that differ, for example ["due_at"].
  fields       String[]
  summary      String
  before       Json?
  after        Json?
  detectedAt   DateTime   @default(now()) @map("detected_at") @db.Timestamptz(3)
  readAt       DateTime?  @map("read_at") @db.Timestamptz(3)

  /// The feed is newest first by id (ids grow with detection time), paged with an id cursor.
  @@index([userId, id])
  @@index([userId, readAt])
  @@index([courseId, id])
  @@map("change_events")
}

/// Planning preferences. A user without a row gets the defaults.
model UserSettings {
  userId            String   @id @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// IANA name, for example America/Chicago. Decides what "today" means.
  timeZone          String   @default("America/Chicago") @map("time_zone")
  /// How much study time Today plans for each day.
  dailyStudyMinutes Int      @default(180) @map("daily_study_minutes")
  /// Study window, in minutes after local midnight; the end is exclusive and may be 1440.
  studyStartMinute  Int      @default(540) @map("study_start_minute")
  studyEndMinute    Int      @default(1320) @map("study_end_minute")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_settings")
}

/// An imported .ics file. Its events are replaced as a whole, never edited one by one.
model CalendarSource {
  id         Int             @id @default(autoincrement())
  userId     String          @map("user_id") @db.Uuid
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  fileName   String?         @map("file_name")
  importedAt DateTime        @default(now()) @map("imported_at") @db.Timestamptz(3)
  events     CalendarEvent[]

  @@index([userId])
  @@map("calendar_sources")
}

/// One occurrence on the calendar. Recurring imported events are stored expanded.
model CalendarEvent {
  id        Int             @id @default(autoincrement())
  userId    String          @map("user_id") @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null for events the user added by hand.
  sourceId  Int?            @map("source_id")
  source    CalendarSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title     String
  location  String?
  /// All-day events store UTC midnight of their first day and of the day after their last.
  startAt   DateTime        @map("start_at") @db.Timestamptz(3)
  endAt     DateTime        @map("end_at") @db.Timestamptz(3)
  allDay    Boolean         @default(false) @map("all_day")
  /// Busy time is subtracted from the study window when Today plans.
  busy      Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, startAt])
  @@index([sourceId])
  @@map("calendar_events")
}
