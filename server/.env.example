# Copy to server/.env for `npm run dev`, `npm run db:migrate` and `npm test`. Never commit .env.
NODE_ENV=development
PORT=8000
# Matches the `db` service in ../docker-compose.yml.
DATABASE_URL=postgresql://canvaswatcher:canvaswatcher@localhost:5432/canvaswatcher
# Tests create and migrate this database themselves; it is emptied before every test.
TEST_DATABASE_URL=postgresql://canvaswatcher:canvaswatcher@localhost:5432/canvaswatcher_test
# At least 32 random characters.
SESSION_SECRET=
# 32 random bytes in base64; encrypts stored Canvas tokens. Changing it means users reconnect Canvas.
CREDENTIALS_KEY=
# The Vite dev server (5173) and the Compose frontend (8080).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Canvas sites users may connect (`*.` matches subdomains).
CANVAS_ALLOWED_HOSTS=canvas.illinois.edu,*.instructure.com
# Minutes between automatic syncs of each account; 0 turns them off.
SYNC_INTERVAL_MINUTES=30
LOG_LEVEL=info
